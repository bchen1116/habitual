rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // yyyymmdd integer for a timestamp (UTC). Rules can't do timezone math,
    // so date checks that need user-local awareness use a ±1-day tolerance.
    function dateInt(ts) {
      return ts.year() * 10000 + ts.month() * 100 + ts.day();
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // "username" is excluded from client writes on purpose: uniqueness is
      // enforced by a transaction in /api/account/username (Admin SDK,
      // which bypasses these rules entirely) against the usernames/{name}
      // claim collection below. Writing it here directly would let a
      // client squat a name without going through that check.
      allow create: if request.auth != null && request.auth.uid == uid
                    && !("username" in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["username"]);
      allow delete: if false;
    }

    // Username uniqueness claims: doc ID is the lowercased handle, value is
    // { uid }. Server-only (Admin SDK bypasses rules) — no client access.
    match /usernames/{name} {
      allow read, write: if false;
    }

    // Cached per-user streak figures over that user's PUBLIC habits, keyed by
    // the date they were computed for (lib/server/leaderboard.ts). Server-only
    // like usernames above: the leaderboard is assembled by a route handler
    // and delivered as JSON, so no client ever reads these docs directly.
    // Keeping it closed means the leaderboard adds no client-readable
    // cross-user surface at all — a user still cannot read anything about
    // another user straight from Firestore.
    match /userStreakStats/{uid} {
      allow read, write: if false;
    }

    match /ledgerEntries/{entryId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.fromUid
                      || request.auth.uid == resource.data.toUid);
      allow create: if false;   // server only (adjudication function)
      // Only the debtor updates, only on the unsettled -> settled
      // transition itself (never again afterward — settledAt can't be
      // backdated, and receiptURL/note can't be swapped in after the fact
      // either; the whole settlement record is a one-time, immutable
      // statement, matching what the UI's SettleDialog actually offers —
      // it only ever renders while status is still "unsettled").
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.fromUid
                    && resource.data.status == "unsettled"
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["status", "settledAt", "receiptURL", "note"])
                    && request.resource.data.status == "settled"
                    && request.resource.data.settledAt == request.time;
      allow delete: if false;
    }

    match /challenges/{cid} {
      // All creation goes through the server (see /api/challenges): join
      // codes need collision checks clients can't perform under these
      // read rules, and the creator's member doc is written server-side.
      allow create: if false;
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.memberIds;
      // Cancel-only, pre-start. Actual term edits (name, dates, stake,
      // skipDays…) go through the server (editChallengeAdmin via
      // /api/challenges/[id] PATCH, Admin SDK — bypasses these rules
      // entirely), which validates bounds these rules can't express
      // (stake $0-10000, skipDays 0-30, whole-week durations). This used to
      // also allow the sole-member creator to write ANY field to ANY value
      // pre-start — the only actual client-side write against this
      // collection is cancelChallenge() writing {status:"cancelled"}
      // (src/lib/challenges.ts) — which meant a creator could directly
      // rig a still-unjoined pool challenge's skipDays/stakeAmount/mode/
      // forfeitType/even createdBy before inviting others to stake real
      // money into it. No legitimate path needs anything broader than this.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.createdBy
                    && resource.data.status == "active"
                    && dateInt(request.time) < int(resource.data.startDate)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
                    && request.resource.data.status == "cancelled";
      allow delete: if false;

      match /members/{uid} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/challenges/$(cid)).data.memberIds;
        // Written server-side only (create + join routes).
        allow write: if false;
      }

      // Invite-only groups only; the requester (to see their own pending
      // status) and the creator (to review/approve) can read a request —
      // no one else can even tell it exists. Written server-side only (join
      // + approve/reject routes).
      match /joinRequests/{uid} {
        allow read: if request.auth != null
                    && (request.auth.uid == uid
                        || request.auth.uid == get(/databases/$(database)/documents/challenges/$(cid)).data.createdBy);
        allow write: if false;
      }

      // NOT {cid} — must not shadow the outer challenge-ID binding.
      match /checkins/{checkinId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/challenges/$(cid)).data.memberIds;
        // Anti-backfill: the doc ID must be "<localDate>_<uid>" for the
        // caller, completedAt must be the server's time, and localDate must
        // be within ±1 day of the server date (covers every timezone).
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.uid
                      && request.auth.uid in get(/databases/$(database)/documents/challenges/$(cid)).data.memberIds
                      && checkinId == request.resource.data.localDate + '_' + request.auth.uid
                      && request.resource.data.completedAt == request.time
                      && int(request.resource.data.localDate) >= dateInt(request.time - duration.value(1, 'd'))
                      && int(request.resource.data.localDate) <= dateInt(request.time + duration.value(1, 'd'));
        allow update, delete: if false;
      }
    }
  }
}
