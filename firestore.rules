rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // yyyymmdd integer for a timestamp (UTC). Rules can't do timezone math,
    // so date checks that need user-local awareness use a ±1-day tolerance.
    function dateInt(ts) {
      return ts.year() * 10000 + ts.month() * 100 + ts.day();
    }

    /**
     * Two ways a check-in can be written, and they are not equivalent.
     *
     * Both require the doc ID to be "<localDate>_<uid>" for the caller and
     * completedAt to be the server's own time, so neither can be dated by a
     * client clock. What differs is how far back the date may reach.
     *
     * LIVE — the ordinary check-in: within ±1 day of the server date, the
     * tolerance every timezone needs, and carrying no backfilledAt (a live
     * check-in claiming to be a backfill would be a contradiction).
     *
     * BACKFILL — a day that was missed, logged after the fact. Bounded on
     * every side, because check-ins are what adjudication counts and a
     * backfilled day moves money exactly like a live one: the cycle must
     * still be active, so a settled result can never be edited after the
     * money has moved; the date must lie inside the cycle's own start..end;
     * and it must be marked with the server's time, so the record can always
     * tell "did it and tapped" from "said so later".
     *
     * Membership *start* is not checked here — that would need the member doc,
     * a second read on every check-in. lib/backfill.ts refuses it client-side,
     * and the worst a bypass buys is a day inside a cycle the caller was
     * already a member of.
     */
    function checkinWritable(cid, checkinId) {
      let c = get(/databases/$(database)/documents/challenges/$(cid)).data;
      let d = request.resource.data;
      return request.auth != null
             && request.auth.uid == d.uid
             && request.auth.uid in c.memberIds
             && checkinId == d.localDate + '_' + request.auth.uid
             && d.completedAt == request.time
             && int(d.localDate) <= dateInt(request.time + duration.value(1, 'd'))
             && (
                  (
                    !("backfilledAt" in d)
                    && int(d.localDate) >= dateInt(request.time - duration.value(1, 'd'))
                  ) || (
                    d.backfilledAt == request.time
                    && c.status == 'active'
                    && d.localDate >= c.startDate
                    && d.localDate <= c.endDate
                  )
                );
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // "username" is excluded from client writes on purpose: uniqueness is
      // enforced by a transaction in /api/account/username (Admin SDK,
      // which bypasses these rules entirely) against the usernames/{name}
      // claim collection below. Writing it here directly would let a
      // client squat a name without going through that check.
      allow create: if request.auth != null && request.auth.uid == uid
                    && !("username" in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["username"]);
      allow delete: if false;
    }

    // Username uniqueness claims: doc ID is the lowercased handle, value is
    // { uid }. Server-only (Admin SDK bypasses rules) — no client access.
    match /usernames/{name} {
      allow read, write: if false;
    }

    // Cached per-user streak figures over that user's PUBLIC habits, keyed by
    // the date they were computed for (lib/server/leaderboard.ts). Server-only
    // like usernames above: the leaderboard is assembled by a route handler
    // and delivered as JSON, so no client ever reads these docs directly.
    // Keeping it closed means the leaderboard adds no client-readable
    // cross-user surface at all — a user still cannot read anything about
    // another user straight from Firestore.
    match /userStreakStats/{uid} {
      allow read, write: if false;
    }

    match /ledgerEntries/{entryId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.fromUid
                      || request.auth.uid == resource.data.toUid);
      allow create: if false;   // server only (adjudication function)
      // Only the debtor updates, only on the unsettled -> settled
      // transition itself (never again afterward — settledAt can't be
      // backdated, and receiptURL/note can't be swapped in after the fact
      // either; the whole settlement record is a one-time, immutable
      // statement, matching what the UI's SettleDialog actually offers —
      // it only ever renders while status is still "unsettled").
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.fromUid
                    && resource.data.status == "unsettled"
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["status", "settledAt", "receiptURL", "note"])
                    && request.resource.data.status == "settled"
                    && request.resource.data.settledAt == request.time;
      allow delete: if false;
    }

    // Collection-group read for a user's OWN reflections across every habit,
    // so the Progress page can fetch them in one query instead of one per
    // habit. Scoped identically to the nested rule below — owner-only — and a
    // collection-group query only succeeds if every document it could return
    // satisfies that, so it must filter `uid == request.auth.uid` (see
    // allMyReflectionsQuery). Read-only on purpose: writes still go through
    // the nested block, which additionally validates the doc id, the rating
    // range and the miss-reason allow-list.
    match /{path=**}/reflections/{reflectionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    match /challenges/{cid} {
      // All creation goes through the server (see /api/challenges): join
      // codes need collision checks clients can't perform under these
      // read rules, and the creator's member doc is written server-side.
      allow create: if false;
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.memberIds;
      // Cancel-only, pre-start. Actual term edits (name, dates, stake,
      // skipDays…) go through the server (editChallengeAdmin via
      // /api/challenges/[id] PATCH, Admin SDK — bypasses these rules
      // entirely), which validates bounds these rules can't express
      // (stake $0-10000, skipDays 0-30, whole-week durations). This used to
      // also allow the sole-member creator to write ANY field to ANY value
      // pre-start — the only actual client-side write against this
      // collection is cancelChallenge() writing {status:"cancelled"}
      // (src/lib/challenges.ts) — which meant a creator could directly
      // rig a still-unjoined pool challenge's skipDays/stakeAmount/mode/
      // forfeitType/even createdBy before inviting others to stake real
      // money into it. No legitimate path needs anything broader than this.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.createdBy
                    && resource.data.status == "active"
                    && dateInt(request.time) < int(resource.data.startDate)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
                    && request.resource.data.status == "cancelled";
      allow delete: if false;

      match /members/{uid} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/challenges/$(cid)).data.memberIds;
        // Written server-side only (create + join routes).
        allow write: if false;
      }

      // Invite-only groups only; the requester (to see their own pending
      // status) and the creator (to review/approve) can read a request —
      // no one else can even tell it exists. Written server-side only (join
      // + approve/reject routes).
      match /joinRequests/{uid} {
        allow read: if request.auth != null
                    && (request.auth.uid == uid
                        || request.auth.uid == get(/databases/$(database)/documents/challenges/$(cid)).data.createdBy);
        allow write: if false;
      }

      // NOT {cid} — must not shadow the outer challenge-ID binding.
      match /checkins/{checkinId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/challenges/$(cid)).data.memberIds;
        allow create: if checkinWritable(cid, checkinId);
        // Still immutable once written: a backfill can add a day that was
        // missed, never erase or rewrite one that was recorded.
        allow update, delete: if false;
      }

      // Spare skips committed to a week that was missed.
      //
      // Readable by every member for the same reason check-ins are: in a pool
      // habit, whether someone's bad week is covered decides who forfeits to
      // whom, and a group can't verify a result it can't see.
      //
      // Written server-side only, and this one genuinely cannot be otherwise.
      // The balance a spare is drawn against is the sum of everything earned
      // across every earlier cycle of the habit less everything spent there;
      // rules can read a fixed number of documents by path but cannot
      // aggregate a collection, let alone a chain of them. Any rule permissive
      // enough to let a client write here would let it mint spares, and a
      // spare is worth the stake. See lib/server/spares-admin.ts.
      match /spares/{spareId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/challenges/$(cid)).data.memberIds;
        allow write: if false;
      }

      // Private per-day reflections: a 1-10 rating of how the session went,
      // and — for a day that was missed — what got in the way.
      //
      // Owner-only, in both directions, which is the whole reason this isn't
      // just two more fields on the check-in doc above: check-ins are readable
      // by every member of the challenge, and a rating other people can see is
      // a rating that gets performed rather than told honestly. Rules can't
      // hide one field of a document, so the honest data needs its own.
      //
      // Unlike check-ins these are mutable and have no anti-backfill window.
      // Backfilling one is harmless by construction: nothing in adjudication,
      // streak math, or the leaderboard reads this collection, so the only
      // thing a late or revised entry changes is what the author sees.
      match /reflections/{reflectionId} {
        function validReflection(data) {
          return data.uid == request.auth.uid
                 && data.localDate is string
                 && reflectionId == data.localDate + '_' + request.auth.uid
                 // Absent is allowed throughout — writes merge, so a rating
                 // write carries no miss fields and vice versa.
                 && (!('rating' in data) || data.rating == null
                     || (data.rating is int && data.rating >= 1 && data.rating <= 10))
                 && (!('missReason' in data) || data.missReason == null
                     || data.missReason in ['no_time', 'too_ambitious', 'wrong_time',
                                            'travel', 'unwell', 'forgot',
                                            'lost_motivation', 'other'])
                 && (!('missNote' in data) || data.missNote == null
                     || (data.missNote is string && data.missNote.size() <= 300))
                 && data.updatedAt == request.time;
        }
        allow read: if request.auth != null && request.auth.uid == resource.data.uid;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/challenges/$(cid)).data.memberIds
                      && validReflection(request.resource.data);
        allow update: if request.auth != null
                      && request.auth.uid == resource.data.uid
                      && validReflection(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      }
    }
  }
}
