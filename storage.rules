rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Receipts are uploaded by the debtor (fromUid) and readable by the
    // debtor and — for user-to-user debts (step 5) — the creditor.
    // Avatars: owner writes; any signed-in user may read (group members
    // and ledger counterparties see each other's avatars).
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /receipts/{uid}/{entryId} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || request.auth.uid == firestore.get(/databases/(default)/documents/ledgerEntries/$(entryId)).data.toUid);
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
